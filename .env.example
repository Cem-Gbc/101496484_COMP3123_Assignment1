# Copy this file to .env and change the values.
# Never commit the real .env file.

# Port for the local server
PORT=3000

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# The app always uses the database "comp3123_assignment1".
MONGODB_URI=mongodb://127.0.0.1:27017
# Atlas example:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority

# Secret key used to sign JWTs. Use a long random value, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# How long a login token is valid (examples: 1h, 30m, 60s)
JWT_EXPIRES_IN=1h

# Rate limits (requests per 15 minutes from one IP address)
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=200
